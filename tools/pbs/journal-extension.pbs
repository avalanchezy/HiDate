#!/bin/bash
#PBS -N HiDate_sources
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
mkdir -p runs/hidate/extended-benchmark
python -X utf8 scripts/collect_extension.py
