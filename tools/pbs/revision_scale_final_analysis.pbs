#!/bin/bash
#PBS -N HIDATE_scale_final_paired
#PBS -q route
#PBS -l nodes=1:ppn=2,mem=12gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
python -X utf8 scripts/analyze_revision_confirmation.py --input runs/hidate/revision-aware/transfer/ruri-scale-final
