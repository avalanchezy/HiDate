#!/bin/bash
#PBS -N HIDATE_scale_cases
#PBS -q route
#PBS -l nodes=1:ppn=2,mem=12gb
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
python -X utf8 scripts/extract_revision_scale_cases.py
