#!/bin/bash
#PBS -N HIDATE_revision_parts
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
out=runs/hidate/revision-aware/native-development
exec > "$out/component-controls.log" 2>&1
python -X utf8 scripts/run_revision_development.py --phase component-controls --evaluation-name valid-components
