#!/bin/bash
#PBS -N HIDATE_French_CE
#PBS -q gpu
#PBS -l nodes=1:ppn=2:gpus=1,mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
out="${HIDATE_REVISION_FISCAL_CE_OUTPUT:-runs/hidate/revision-aware/transfer/fiscal-ce}"
mkdir -p "$out"
exec > "$out/ce.log" 2>&1
python -X utf8 scripts/run_revision_fiscal_ce.py score --output "$out"
python -X utf8 scripts/run_revision_fiscal_ce.py rank --output "$out"
python -X utf8 scripts/run_revision_fiscal_ce.py prepare-reader --output "$out"
