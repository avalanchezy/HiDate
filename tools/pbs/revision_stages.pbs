#!/bin/bash
#PBS -N HIDATE_saved_stages
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
OUT="${HIDATE_STAGE_OUTPUT:-runs/hidate/revision-aware/diagnostics/stage-reachability/regression}"
COHORTS="${HIDATE_STAGE_COHORTS:-ruri120 ruri1000 qwen120}"
mkdir -p "$OUT"
exec > "$OUT/run.log" 2>&1
trap 'code=$?; printf "%s\n" "$code" > "$OUT/exit-code.txt"' EXIT
python -X utf8 scripts/analyze_revision_stages.py --cohorts $COHORTS --output "$OUT"
