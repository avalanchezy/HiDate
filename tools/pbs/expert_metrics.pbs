#!/bin/bash
#PBS -N HiDate_expert_metrics
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=48gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
out=runs/hidate/expert-benchmark/analysis
mkdir -p "$out"
exec > "$out/run.log" 2>&1
trap 'code=$?; printf "%s\n" "$code" > "$out/exit-code.txt"' EXIT
python -X utf8 scripts/run_expert_retrieval.py evaluate --queries data/expert-benchmark/unlabeled/queries.jsonl --gold data/expert-benchmark/sealed/gold.jsonl --query-index data/index/hidate/expert-benchmark/queries --output runs/hidate/expert-benchmark
python -X utf8 scripts/analyze_expert_retrieval.py --evaluation runs/hidate/expert-benchmark/final/evaluation.json --predictions runs/hidate/expert-benchmark/final/predictions.jsonl --date-pairs data/expert-benchmark/sealed/date-pairs.jsonl --output "$out"
