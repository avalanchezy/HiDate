#!/bin/bash
#PBS -N HIDATE_Qwen_CE_TEST
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
out=runs/hidate/revision-aware/transfer/qwen-test
mkdir -p "$out/ce-controls"
exec > "$out/ce-controls/run.log" 2>&1
python -X utf8 scripts/run_revision_qwen_test.py --phase evaluate-controls --output "$out" \
    --frozen-recipe runs/hidate/revision-aware/frozen-recipe.json \
    --ce-development runs/hidate/revision-aware/qwen-ce-training
