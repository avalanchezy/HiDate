#!/bin/bash
#PBS -N HiDate_scaleEval
#PBS -q gpu
#PBS -l nodes=1:ppn=2:gpus=1,mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TOKENIZERS_PARALLELISM=false
python -X utf8 scripts/scale_worker.py evaluate \
    --index "${HIDATE_SCALE_INDEX:-data/index/hidate/extended-benchmark/scale}" \
    --output "${HIDATE_SCALE_OUTPUT:-runs/hidate/extended-benchmark/scale}"
