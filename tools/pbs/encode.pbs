#!/bin/bash
#PBS -N HiDate_encode
#PBS -q gpu
#PBS -l nodes=1:ppn=4:gpus=1,mem=24gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TOKENIZERS_PARALLELISM=false
export HIDATE_ENCODE_RUN_DIR="runs/hidate/pbs/encode"
mkdir -p "$HIDATE_ENCODE_RUN_DIR"
exec > "$HIDATE_ENCODE_RUN_DIR/run.log" 2>&1
finish() {
    export HIDATE_ENCODE_EXIT_CODE=$?
    python - <<'PY'
from datetime import datetime, timezone
import json, os
from pathlib import Path
run = Path(os.environ["HIDATE_ENCODE_RUN_DIR"])
path = Path("data/index/hidate/embeddings/encoding.json")
manifest = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
if path.exists():
    (run / "encoding-manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
exit_code = int(os.environ["HIDATE_ENCODE_EXIT_CODE"])
record = {"job_id": os.environ.get("PBS_JOBID"), "exit_code": exit_code,
          "finished_at_utc": datetime.now(timezone.utc).isoformat(), "encoding_manifest_present": path.exists(),
          "encoding_complete": exit_code == 0 and manifest.get("complete", False),
          "training_runs": 0, "query_encoding_runs": 0}
for key in ("corpus_rows", "unique_model_texts", "encoded_unique_texts", "encoded_input_tokens",
            "padded_token_slots", "encoder_wall_seconds_with_cuda_sync", "batch_count"):
    if key in manifest:
        record[key] = manifest[key]
(run / "completion.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
PY
}
trap finish EXIT
python -X utf8 scripts/encode_corpus.py --index-dir data/index/hidate --stack models/ruri/model-stack.json \
    --preflight runs/hidate/pbs/preflight/preflight.json --output-dir data/index/hidate/embeddings
