#!/bin/bash
#PBS -N HIDATE_revision_freeze
#PBS -q route
#PBS -l nodes=1:ppn=1,mem=2gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
python -X utf8 scripts/freeze_revision_recipe.py
