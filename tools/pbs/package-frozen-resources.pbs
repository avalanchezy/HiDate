#!/bin/bash
#PBS -N HIDATE_frozen_resources
#PBS -q route
#PBS -l nodes=1:ppn=1,mem=8gb
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PYTHONPATH="$PWD/src"
export HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TOKENIZERS_PARALLELISM=false
"${HIDATE_VENV:-$PWD/.venv}/bin/python" -X utf8 scripts/download_frozen_package_models.py --root .
