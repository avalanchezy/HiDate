#!/bin/bash
#PBS -N HIDATE_latency_actual
#PBS -q gpu
#PBS -l nodes=1:ppn=4:gpus=1,mem=24gb
#PBS -l walltime=03:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
out="${HIDATE_LATENCY_OUTPUT:-runs/hidate/revision-aware/cost-benchmark}"
mkdir -p "$out"
exec > "$out/run.log" 2>&1
python -X utf8 scripts/benchmark_revision_latency.py --phase prepare --output "$out"
python -X utf8 scripts/benchmark_revision_latency.py --phase run --output "$out" \
    --frozen-recipe runs/hidate/revision-aware/frozen-recipe.json
