#!/bin/bash
#PBS -N HIDATE_QWEN_CE_prep
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
OUT="${HIDATE_QWEN_CE_TRAIN_OUTPUT:-runs/hidate/revision-aware/qwen-ce-training}"
mkdir -p "$OUT"
exec > "$OUT/prepare.log" 2>&1
python -X utf8 scripts/run_revision_qwen_ce_training.py --phase prepare --output "$OUT"
