#!/bin/bash
#PBS -N HiDate_abl_fit
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
python -X utf8 scripts/run_ablations.py --phase fit
