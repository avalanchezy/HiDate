#!/bin/bash
#PBS -N HIDATE_expert_sources
#PBS -q route
#PBS -l nodes=1:ppn=2,mem=8gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 CUDA_VISIBLE_DEVICES=""
mkdir -p runs/hidate/expert-dates
exec > runs/hidate/expert-dates/acquire.log 2>&1
python -X utf8 scripts/prepare_expert_dates.py acquire --workers 4
