#!/bin/bash
#PBS -N HiDate_missing_prep
#PBS -q route
#PBS -l nodes=1:ppn=1,mem=12gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
mkdir -p runs/hidate/pbs/missing-control-prepare
exec > runs/hidate/pbs/missing-control-prepare/run.log 2>&1
trap 'status=$?; printf "%s\n" "$status" > runs/hidate/pbs/missing-control-prepare/exit-code.txt' EXIT
python -X utf8 scripts/prepare_missing_control.py
