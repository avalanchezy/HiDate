#!/bin/bash
#PBS -N HIDATE_FR_26_readback
#PBS -q route
#PBS -l nodes=1:ppn=2,mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 CUDA_VISIBLE_DEVICES=""
base=runs/hidate/revision-aware/transfer
out="$base/fiscal-ce/analysis-expanded"
mkdir -p "$out"
exec > "$out/run.log" 2>&1
python -X utf8 scripts/analyze_revision_fiscal.py --analysis "$out" \
  --extra-reader "$base/fiscal-strong-controls/reader"
