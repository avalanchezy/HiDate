#!/bin/bash
#PBS -N HiDate_dev_select
#PBS -q route
#PBS -l nodes=1:ppn=1,mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
mkdir -p runs/hidate/pbs/dev-selection
exec > runs/hidate/pbs/dev-selection/run.log 2>&1
trap 'status=$?; printf "%s\n" "$status" > runs/hidate/pbs/dev-selection/exit-code.txt' EXIT
python -X utf8 scripts/select_development.py --dev-dir runs/hidate/dev --output runs/hidate/policy/frozen.json
