#!/bin/bash
#PBS -N HIDATE_expert_index
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
out=data/index/hidate/expert-benchmark/corpus
mkdir -p "$out" runs/hidate/expert-benchmark
exec > "$out/prepare.log" 2>&1
python -X utf8 scripts/build_expert_index.py prepare \
  --census data/raw/hidate/expert-dates \
  --original-index data/index/hidate/extended-benchmark/scale --index "$out"
