#!/bin/bash
#PBS -N HIDATE_confirmation_cache
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES="" TOKENIZERS_PARALLELISM=false
out=runs/hidate/revision-aware/confirmation/discovery
mkdir -p "$out"
exec > "$out/run.log" 2>&1
trap 'code=$?; printf "%s\n" "$code" > "$out/exit-code.txt"' EXIT
python -X utf8 scripts/discover_revision_confirmation.py --output "$out"
