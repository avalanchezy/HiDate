#!/bin/bash
#PBS -N HiDate_FiscalEncode
#PBS -q gpu
#PBS -l nodes=1:ppn=1:gpus=1,mem=32gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TOKENIZERS_PARALLELISM=false
python -X utf8 scripts/fiscal_benchmark.py encode \
    --stack "${HIDATE_FISCAL_STACK:-models/qwen3/model-stack.json}" \
    --batch-size "${HIDATE_FISCAL_BATCH_SIZE:-16}"
