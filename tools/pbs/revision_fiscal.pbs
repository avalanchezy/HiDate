#!/bin/bash
#PBS -N HIDATE_revision_fiscal
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES="" TOKENIZERS_PARALLELISM=false
out="${HIDATE_REVISION_FISCAL_OUTPUT:-runs/hidate/revision-aware/transfer/fiscal-native}"
mkdir -p "$out"
exec > "$out/run.log" 2>&1
python -X utf8 scripts/run_revision_fiscal.py \
    --phase "${HIDATE_REVISION_FISCAL_PHASE:-all}" --output "$out"
