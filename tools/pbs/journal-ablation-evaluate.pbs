#!/bin/bash
#PBS -N HiDate_abl_eval
#PBS -q gpu
#PBS -l nodes=1:ppn=4:gpus=1,mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
python -X utf8 scripts/run_ablations.py --phase evaluate
