#!/bin/bash
#PBS -N HiDate_prepare
#PBS -q route
#PBS -l nodes=1:ppn=1,mem=12gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
mkdir -p runs/hidate/pbs/prepare
exec > runs/hidate/pbs/prepare/run.log 2>&1
finish() {
    export HIDATE_EXIT_CODE=$?
    python - <<'PY'
import json, os
from datetime import datetime, timezone
from pathlib import Path
manifest_path = Path("data/processed/hidate/preparation.json")
manifest = json.loads(manifest_path.read_text(encoding="utf-8")) if manifest_path.exists() else {}
record = {"job_id": os.environ.get("PBS_JOBID"), "exit_code": int(os.environ["HIDATE_EXIT_CODE"]),
          "finished_at_utc": datetime.now(timezone.utc).isoformat(),
          "preparation_present": manifest_path.exists(), "preparation_complete": manifest.get("complete", False),
          "source_dir": "data/raw/hidate/full", "output_dir": "data/processed/hidate",
          "training_runs": 0, "model_inference_runs": 0}
if int(os.environ["HIDATE_EXIT_CODE"]) == 0:
    record["statistics"] = manifest["statistics"]
Path("runs/hidate/pbs/prepare/completion.json").write_text(json.dumps(record, indent=2) + "\n")
PY
    if [ "$HIDATE_EXIT_CODE" -eq 0 ]; then
        tar -czf hidate-prepared-data.tar.gz data/processed/hidate runs/hidate/pbs/prepare
    fi
}
trap finish EXIT
python -X utf8 scripts/prepare_data.py
