#!/bin/bash
#PBS -N HiDate_expert_queries
#PBS -q gpu
#PBS -l nodes=1:ppn=4:gpus=1,mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
out=runs/hidate/expert-benchmark/queries
mkdir -p "$out"
exec > "$out/run.log" 2>&1
trap 'code=$?; printf "%s\n" "$code" > "$out/exit-code.txt"' EXIT
python -X utf8 scripts/encode_queries.py \
  --queries data/expert-benchmark/unlabeled/queries.jsonl \
  --output-dir data/index/hidate/expert-benchmark/queries
