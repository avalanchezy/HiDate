#!/bin/bash
#PBS -N HiDate_final_discovery
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HIDATE_FINAL_DISCOVERY_RUN_DIR="${HIDATE_FINAL_DISCOVERY_RUN_DIR:-runs/hidate/pbs/final-discovery}"
export HIDATE_FINAL_DISCOVERY_OUTPUT_DIR="${HIDATE_FINAL_DISCOVERY_OUTPUT_DIR:-runs/hidate/final-discovery}"
mkdir -p "$HIDATE_FINAL_DISCOVERY_RUN_DIR"
exec > "$HIDATE_FINAL_DISCOVERY_RUN_DIR/run.log" 2>&1
finish() {
    export HIDATE_FINAL_DISCOVERY_EXIT_CODE=$?
    python - <<'PY'
from datetime import datetime, timezone
import json, os
from pathlib import Path
path = Path(os.environ["HIDATE_FINAL_DISCOVERY_OUTPUT_DIR"]) / "discovery-summary.json"
manifest = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
exit_code = int(os.environ["HIDATE_FINAL_DISCOVERY_EXIT_CODE"])
record = {"job_id": os.environ.get("PBS_JOBID"), "exit_code": exit_code,
          "finished_at_utc": datetime.now(timezone.utc).isoformat(),
          "discovery_complete": exit_code == 0 and manifest.get("complete", False),
          "training_runs": 0, "model_forward_calls": 0}
for key in ("query_rows", "completed_query_rows", "retrieval_runs", "cache_hits",
            "current_chunk_scoring_count", "wall_seconds", "model_pin", "policy_path"):
    if key in manifest:
        record[key] = manifest[key]
record["datasets"] = {name: {key: row[key] for key in ("complete", "query_rows", "completed_query_rows")}
                      for name, row in manifest.get("outputs", {}).items()}
Path(os.environ["HIDATE_FINAL_DISCOVERY_RUN_DIR"]).joinpath("completion.json").write_text(
    json.dumps(record, indent=2) + "\n", encoding="utf-8")
PY
}
trap finish EXIT
python -X utf8 scripts/discover_final.py --output-dir "$HIDATE_FINAL_DISCOVERY_OUTPUT_DIR"
