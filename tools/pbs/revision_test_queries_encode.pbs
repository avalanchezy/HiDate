#!/bin/bash
#PBS -N HIDATE_newTest_queryVec
#PBS -q gpu
#PBS -l nodes=1:ppn=1:gpus=1,mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TOKENIZERS_PARALLELISM=false
out=runs/hidate/revision/test-queries
mkdir -p "$out"
exec > "$out/encode-run.log" 2>&1
python -X utf8 scripts/prepare_revision_test_queries.py encode
