#!/bin/bash
#PBS -N HIDATE_Qwen_revision
#PBS -q route
#PBS -l nodes=1:ppn=4,mem=24gb
#PBS -l walltime=03:00:00
#PBS -j oe
set -euo pipefail
cd "${HIDATE_PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PATH="${HIDATE_VENV:-$PWD/.venv}/bin:$PATH" PYTHONPATH="$PWD/src:$PWD/scripts"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
prior=runs/hidate/extended-benchmark/qwen3
out=runs/hidate/revision-aware/qwen-native-development
baseline=runs/hidate/revision-aware/qwen-original-lambdamart
mkdir -p "$out"
exec > "$out/run.log" 2>&1
trap 'code=$?; printf "%s\n" "$code" > "$out/exit-code.txt"' EXIT
discovery=("$prior/discovery/exact-train-valid/candidates.jsonl" "$prior/discovery/paraphrase-train-valid/candidates.jsonl")
python -X utf8 scripts/run_lambdamart.py --phase fit \
  --train-discovery "${discovery[@]}" --reference-ranker "$prior/ranker/address-model.json" --output-dir "$baseline"
python -X utf8 scripts/run_revision_development.py --discovery "${discovery[@]}" \
  --index data/index/hidate-qwen3 --original-lr "$prior/ranker/address-model.json" \
  --original-tree "$baseline/ranker/model.txt" --output "$out"
python -X utf8 scripts/run_revision_development.py --phase component-controls \
  --index data/index/hidate-qwen3 --original-lr "$prior/ranker/address-model.json" \
  --original-tree "$baseline/ranker/model.txt" --output "$out" --evaluation-name valid-components
python -X utf8 scripts/analyze_revision_development.py --input "$out/valid-components"
